{
    "ROS2.distro": "jazzy",
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/build/boat_perception",
        "${workspaceFolder}/build/boat_image_processing",
        "${workspaceFolder}/install/boat_perception/lib/python3.12/site-packages",
        "${workspaceFolder}/install/boat_image_processing/lib/python3.12/site-packages",
        "/opt/ros/${env:ROS_DISTRO}/lib/python3.12/site-packages"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/build/boat_perception",
        "${workspaceFolder}/build/boat_image_processing",
        "${workspaceFolder}/install/boat_perception/lib/python3.12/site-packages",
        "${workspaceFolder}/install/boat_image_processing/lib/python3.12/site-packages",
        "/opt/ros/${env:ROS_DISTRO}/lib/python3.12/site-packages"
    ],
    "yaml.customTags": [
        "!override sequence"
    ],
    
    // Use the Ruff installed in environment instead of version packaged
    // from the extension
    "ruff.importStrategy": "fromEnvironment",

    "python-envs.defaultEnvManager": "ms-python.python:system",

    "python.analysis.diagnosticSeverityOverrides": {
        "reportUnknownMemberType": "none",
        "reportUnknownArgumentType": "none",
        "reportUnknownVariableType": "none",
        "reportMissingTypeStubs": "none",
        "reportMissingParameterType": "none",
        "reportUnknownLambdaType": "none"
    },
    
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.ruff": "explicit",
          "source.organizeImports.ruff": "explicit"
        }
    }
}
